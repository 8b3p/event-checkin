# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the app is reachable. This is what guest QR codes point at,
# so it must be the public URL once you deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection string. Local dev uses the Docker Compose service:
DATABASE_URL=postgres://door:door@localhost:5433/door_dev
